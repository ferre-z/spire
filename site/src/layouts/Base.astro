---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GrainField from "../components/GrainField.tsx";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Spire — Visual orchestrator for coding-agent graphs",
  description = "Build durable, visual workflow graphs that route coding agents through OpenCode, Codex, and Claude Code — with isolated git worktrees, Markdown collaboration, and an MCP control plane.",
} = Astro.props;
const pageTitle = title.endsWith(" · Spire") || title === "Spire"
  ? title
  : `${title} · Spire`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#07090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <GrainField client:load />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      main { position: relative; z-index: 1; }
    </style>

    <script>
      // scroll-reveal observer across static sections
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>