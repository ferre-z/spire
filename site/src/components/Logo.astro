---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"svg"> {
  /** data-node-* semantic color overrides for the mini-graph */
  flow?: boolean;
}

const { flow = true, ...rest } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  width="30"
  height="30"
  fill="none"
  aria-hidden="true"
  {...rest}
>
  <defs>
    <linearGradient id="lgo-flow" x1="4" y1="6" x2="36" y2="34" gradientUnits="userSpaceOnUse">
      <stop stop-color="#4ee6c3" />
      <stop offset="0.55" stop-color="#38bdf8" />
      <stop offset="1" stop-color="#a98cff" />
    </linearGradient>
  </defs>
  <g stroke-width="1.6" stroke-linecap="round">
    <path d="M9 30 C 9 22, 14 20, 19 16" stroke="url(#lsp-flow)" opacity="0.7" />
    <path d="M19 16 C 24 12, 24 8, 31 8" stroke="url(#lsp-flow)" opacity="0.7" />
  </g>
  <g>
    <circle cx="31" cy="8" r="3.4" stroke="#4ee6c3" stroke-width="1.6" fill="#071510" />
    <circle cx="9" cy="30" r="3.4" stroke="#a98cff" stroke-width="1.6" fill="#0d0a18" />
    <circle cx="19" cy="16" r="4.2" stroke="#38bdf8" stroke-width="1.6" fill="#081219" />
  </g>
</svg>