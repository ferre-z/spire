---
import Logo from "./Logo.astro";

const links = [
  { href: "/#features", label: "Features" },
  { href: "/#workflow", label: "Workflow" },
  { href: "/docs", label: "Docs" },
  { href: "/plugins", label: "Plugins" },
];
---

<header class="nav" id="top">
  <div class="nav-inner container">
    <a class="brand" href="/" aria-label="Spire home">
      <Logo />
      <span class="brand-name">Spire</span>
      <span class="brand-tag">v0.1.0</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class="nav-link mono">{l.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a class="btn btn-ghost nav-ghost mono" href="/docs#install">Install</a>
      <a class="btn nav-cta mono" href="/docs">Get started</a>
    </div>

    <button class="nav-burger" aria-label="Open menu" aria-expanded="false" data-menu aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu-panel>
    <nav aria-label="Mobile">
      {links.map((l) => (
        <a href={l.href} class="mono" data-menu-item>{l.label}</a>
      ))}
      <a href="/docs" class="mono">Get started →</a>
    </nav>
  </div>
</header>

<script>
  // mobile menu toggle
  const burger = document.querySelector("[data-menu]");
  const panel = document.querySelector("[data-menu-panel]");
  burger?.addEventListener("click", () => {
    const open = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!open));
    panel.hidden = open;
    document.body.classList.toggle("menu-open", !open);
  });
  panel?.querySelectorAll("[data-menu-item]").forEach((a) =>
    a.addEventListener("click", () => {
      burger.setAttribute("aria-expanded", "false");
      panel.hidden = true;
      document.body.classList.remove("no-scroll");
    })
  );

  // nav shrink on scroll
  const nav = document.querySelector(".nav");
  const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 8);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style is:global>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition: background 0.3s var(--bez-fast), border-color 0.3s var(--bez-fast),
      backdrop-filter 0.3s var(--bez-fast);
  }
  .nav.scrolled {
    background: rgba(7, 9, 11, 0.78);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: var(--line);
  }
  .nav-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }
  .brand-name {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .brand-tag {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .nav-links {
    display: flex;
    gap: 4px;
  }
  .nav-link {
    padding: 8px 13px;
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--ink-dim);
    transition: color 0.18s var(--bez-fast), background 0.18s var(--bez-fast);
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--bg-2);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav .btn { padding: 9px 16px; font-size: 12.5px; border-radius: 10px; }
  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: 0;
    padding: 10px 4px;
    cursor: pointer;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--ink-dim);
    border-radius: 2px;
  }
  .mobile-menu {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 59;
    background: rgba(7, 9, 11, 0.96);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    padding: 28px 24px 40px;
    animation: fade-in 0.25s var(--bez-fast);
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mobile-menu .mono, .mobile-menu [data-menu-item] {
    padding: 14px 8px;
    font-family: var(--mono);
    font-size: 18px;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  @keyframes fade-in { from { opacity: 0 } to { opacity: 1 } }

  @media (max-width: 860px) {
    .nav-links, .nav-ghost { display: none; }
    .nav-burger { display: flex; }
    .nav-cta { margin-left: auto; }
  }
  @media (max-width: 480px) {
    .brand-tag { display: none; }
    .nav-cta { padding: 8px 12px; font-size: 11.5px; }
  }
</style>